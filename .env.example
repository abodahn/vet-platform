# ══════════════════════════════════════════════════════════════════════
#  Aleefy Platform — Environment Variables Template
#  Copy this file to .env (development) or .env.production (production).
#  Loading order (run.py): .env.<FLASK_ENV> first, then .env as fallback.
#  Shell environment variables always win over file values.
#  NEVER commit .env / .env.development / .env.production.
#  PLACEHOLDERS ONLY — no real value belongs in this file.
# ══════════════════════════════════════════════════════════════════════

# ── Flask / Platform ──────────────────────────────────────────────────
# development | production — selects the config class and the .env.<stage> file
FLASK_ENV=production

# Session signing key. Production requires >= 32 chars and no "CHANGE" in it.
#   python -c "import secrets; print(secrets.token_hex(64))"
PLATFORM_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_128_CHAR_HEX_STRING

# Send session cookies over HTTPS only (1 in production, 0 for plain-HTTP dev)
SESSION_COOKIE_SECURE=1

# 1 enables gunicorn's auto-reload — development only
PLATFORM_DEBUG=0

# ── Database ──────────────────────────────────────────────────────────
# PostgreSQL DSN (Neon / Supabase / local). Empty = fall back to SQLite.
POSTGRES_DSN=postgresql://DB_USER:DB_PASSWORD@HOST:5432/DBNAME?sslmode=require

# SQLite file used when POSTGRES_DSN is empty
PLATFORM_DB_PATH=/app/data/platform.db

# ── Admin Seed (used ONLY on first-run DB initialization) ─────────────
# Must be strong: min 12 chars, upper + lower + digit + special character.
PLATFORM_ADMIN_USER=admin
PLATFORM_ADMIN_PASS=CHANGE_ME_Min12Chars_Upper_Lower_Digit_Special!

# ── CORS (public booking/contact/emergency API) ───────────────────────
# Exact website origin. Unset or "*" is a hard startup error in production.
CORS_ALLOWED_ORIGIN=https://your-website-domain.com

# Escape hatch: set to 1 to accept the "*" wildcard in production deliberately.
CORS_ALLOW_WILDCARD=0

# ── Deployment identity ───────────────────────────────────────────────
# One deployment = one clinic. This name tags every Sentry event and the
# startup log line, so an error report says WHOSE clinic it came from.
# Leave empty to use the machine's hostname.
CLINIC_ID=

# ── Version ───────────────────────────────────────────────────────────
# The version number itself lives in the VERSION file at the repo root, not
# here. These two only exist for builds that ship without a .git directory
# (Docker, zip deploy) and want the exact commit and build date recorded.
# GIT_COMMIT=
# BUILD_DATE=

# ── Logging ───────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR — default INFO (DEBUG when app.debug is on)
LOG_LEVEL=INFO

# Days to keep the JSON log files written by models/logging_db.py.
# Applied by a sweep at application startup (models/logging_setup.py); an
# instance that never restarts keeps expired files until it does.
# Does NOT apply to logs/app.log — that one rotates by size, 5 MB x 5.
LOG_FILE_RETENTION_DAYS=7

# ── Error aggregation (optional) ──────────────────────────────────────
# Leave SENTRY_DSN empty to disable entirely — no package needed, no
# behaviour change. To enable: uncomment sentry-sdk in requirements.txt.
# Events are tagged with CLINIC_ID, the version, the commit and the
# per-request correlation ID; request bodies, query strings, cookies,
# headers and traceback locals are stripped before sending.
SENTRY_DSN=
# Fraction of errors sent (1.0 = all). Lower only if the free tier bites.
SENTRY_SAMPLE_RATE=1.0
# Performance tracing. 0.0 = off; it costs the same quota as errors.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Emergency Contact (returned in /api/public/emergency response) ────
EMERGENCY_PHONE=+20XXXXXXXXXX

# ── AI Assistant (freellmapi / OpenAI-compatible proxy) ───────────────
AI_BASE_URL=http://localhost:3001/v1
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemini-2.5-flash

# Google Generative AI key used by the imaging module (optional)
GOOGLE_API_KEY=your-google-api-key-here

# ── WhatsApp / Wapilot Integration ────────────────────────────────────
# Empty token = stub mode, messages are logged but not sent.
WAPILOT_TOKEN=your-wapilot-token-here
# Passed through by docker-compose; no code reads it today.
WAPILOT_BASE_URL=https://api.wapilot.io

# ── Waiting-room display ──────────────────────────────────────────────
# Shared token for the unauthenticated waiting-room screen (appointments)
WAITING_ROOM_TOKEN=your-waiting-room-token-here

# ── Platform Branding (optional overrides) ────────────────────────────
PLATFORM_TITLE=Aleefy
PLATFORM_TITLE_AR=اليفي
PLATFORM_SUBTITLE=Dr. Hatem El Khateeb
PLATFORM_TAGLINE=Happy Pets, Healthy Lives

# ── Build / Version metadata (shown by /system and /api/v1) ───────────
APP_VERSION=1.0.0
BUILD_NUMBER=production_final_v1
RELEASE_DATE=2026-05-24

# ── Legacy App Integration ────────────────────────────────────────────
LEGACY_APP_URL=http://localhost:5000
LEGACY_APP_ENABLED=1
# Folder holding the legacy clinic app's data files
LEGACY_DATA_DIR=../ppc_diagnostics_work/data

# ── Server Binding ────────────────────────────────────────────────────
PLATFORM_HOST=0.0.0.0
PLATFORM_PORT=5100
